# Required for JWT signing (HS256)
JWT_SECRET=change-me

# Optional: override token expiry (minutes)
JWT_EXPIRES_MINUTES=60

# Optional: override DB connection if db_connection.txt path differs in deployment
# If DATABASE_URL is set, it should be a postgres URL like:
# postgresql://user:password@host:port/dbname
DATABASE_URL=

# Optional: override location of db_connection.txt
DB_CONNECTION_FILE=
